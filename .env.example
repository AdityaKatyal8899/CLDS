# MongoDB Atlas Configuration (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=clds

# Python Process Runner Configuration for Next.js Subprocess Invocation
PYTHON_EXECUTABLE=python
CLDS_ENGINE_PATH=.

# Google Maps / Places API Configuration (Optional - only needed if --provider google is used)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Legacy SQLite DB Path (Used for migration utility)
CLDS_DB_PATH=data/clds.db

# Default Export Directory (Defaults to data/exports)
CLDS_EXPORT_DIR=data/exports

